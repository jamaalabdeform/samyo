# Adresse publique du site (canonical, sitemap, OpenGraph)
NEXT_PUBLIC_SITE_URL=https://samyo.stipway.com
# Indexation Google : laisser vide sur l'adresse de prévisualisation, mettre 1 sur le domaine définitif
NEXT_PUBLIC_INDEXABLE=
# Code d'accès à /espace-pro (obligatoire en production)
ADMIN_ACCESS_CODE=
# Réception des demandes par e-mail (https://resend.com)
RESEND_API_KEY=
LEAD_EMAIL_TO=
LEAD_EMAIL_FROM=
# Optionnel : webhook où transmettre chaque demande (CRM, Make, Zapier, n8n…)
LEAD_WEBHOOK_URL=
# Optionnel : Google Tag Manager (avec bandeau de consentement)
NEXT_PUBLIC_GTM_ID=
# Optionnel : autre image de fourgon pour le hero
NEXT_PUBLIC_VAN_IMAGE=
