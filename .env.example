# ─── Site ────────────────────────────────────────────────────────────────
# Adresse publique du site (canonical, sitemap, OpenGraph)
NEXT_PUBLIC_SITE_URL=https://www.samyo-demenagement.com
# Indexation Google : automatique en production Vercel ; 0 pour la couper, 1 pour la forcer ailleurs
NEXT_PUBLIC_INDEXABLE=
# Search Console, méthode « balise HTML » : coller uniquement le code content="…"
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# ─── Coordonnées (facultatif : sinon valeurs de src/config/company.ts) ───
# E-mail public affiché sur le site (ex. adresse pro au nom de domaine)
NEXT_PUBLIC_CONTACT_EMAIL=
# Numéro WhatsApp au format international (+33…)
NEXT_PUBLIC_WHATSAPP_NUMBER=
# Lien fourni par Jawabot, uniquement s'il remplace le lien wa.me
NEXT_PUBLIC_JAWABOT_URL=
# Clé du widget de discussion Jawabot (par défaut celle de SAMYO ; "off" pour le masquer)
NEXT_PUBLIC_JAWABOT_WIDGET_KEY=

# ─── Réception des demandes par e-mail (https://resend.com) ──────────────
# Sans clé, aucune demande n'est envoyée (affichage console en développement)
RESEND_API_KEY=
# Destinataire(s) des demandes, séparés par des virgules (par défaut : contact@samyo-demenagement.com)
LEAD_EMAIL_TO=
# Expéditeur sur le domaine VÉRIFIÉ dans Resend (indispensable pour que le client reçoive son récapitulatif)
# ex. "SAMYO Déménagement <devis@samyo-demenagement.com>"
LEAD_EMAIL_FROM=
# 1 pour autoriser l'aperçu /api/dev/email-preview en production (déconseillé)
ENABLE_EMAIL_PREVIEW=

# ─── Facultatif ──────────────────────────────────────────────────────────
# Code d'accès à /espace-pro (module de démonstration, hors V1)
ADMIN_ACCESS_CODE=
# Webhook où transmettre chaque demande (Make, n8n, futur CRM…)
LEAD_WEBHOOK_URL=
# Google Analytics 4 (ex. G-XXXXXXX) : chargé seulement après accord du visiteur (bandeau intégré)
NEXT_PUBLIC_GA_ID=
# Google Tag Manager : même règle de consentement
NEXT_PUBLIC_GTM_ID=
# Autre image de fourgon pour le hero
NEXT_PUBLIC_VAN_IMAGE=
